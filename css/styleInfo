/* =========================================================
   BUSUCR - PÁGINA "NOSOTROS"
   Hoja de estilos independiente (no depende de style.css)
========================================================= */


/* =========================================================
   VARIABLES
========================================================= */

:root {

    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --primary-light: #eff6ff;

    --green: #16a34a;
    --green-light: #dcfce7;

    --yellow: #d97706;
    --yellow-light: #fef3c7;

    --red: #dc2626;
    --red-light: #fee2e2;

    --dark: #0f172a;
    --dark-secondary: #1e293b;

    --text: #334155;
    --text-light: #64748b;

    --background: #f8fafc;
    --white: #ffffff;

    --border: #e2e8f0;

    --shadow:
        0 10px 30px rgba(15, 23, 42, 0.08);

    --shadow-hover:
        0 18px 40px rgba(15, 23, 42, 0.14);

    --radius: 16px;

    --font-display: "Space Grotesk", "Segoe UI", sans-serif;
    --font-body: "Inter", "Segoe UI", Roboto, Arial, sans-serif;
    --font-mono: "JetBrains Mono", "Courier New", monospace;
}


/* =========================================================
   RESET GLOBAL
========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {

    font-family: var(--font-body);

    background:
        linear-gradient(
            180deg,
            #f8fafc 0%,
            #eef4ff 100%
        );

    color: var(--text);

    min-height: 100vh;

    line-height: 1.6;
}

h1, h2, h3 {

    font-family: var(--font-display);

    letter-spacing: -0.02em;

}


/* =========================================================
   UTILIDAD: ETIQUETA "EYEBROW"
========================================================= */

.eyebrow {

    font-family: var(--font-mono);

    font-weight: 600;

    letter-spacing: 0.14em;

    text-transform: uppercase;

}


/* =========================================================
   ENCABEZADO DEL SITIO (logo + navegación)
========================================================= */

.site-header {

    width: 100%;

    padding: 14px 7%;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 16px;

    background: rgba(255, 255, 255, 0.92);

    border-bottom: 1px solid var(--border);

    position: sticky;

    top: 0;

    z-index: 1000;

    backdrop-filter: blur(14px);

    -webkit-backdrop-filter: blur(14px);

    box-shadow:
        0 4px 20px rgba(15, 23, 42, 0.05);

}


.site-header .logo {

    display: flex;

    align-items: center;

    gap: 11px;

}


.site-header .logo-icon {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    width: 36px;

    height: 36px;

    border-radius: 10px;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--primary-dark)
        );

    color: white;

    font-family: var(--font-display);

    font-weight: 700;

    font-size: 17px;

}


.site-header .logo-text h1 {

    font-size: 19px;

    font-weight: 700;

    letter-spacing: -0.01em;

    color: var(--dark);

}


.site-header .nav {

    display: flex;

    align-items: center;

    gap: 4px;

}


.site-header .nav a {

    padding: 9px 15px;

    border-radius: 9px;

    color: var(--text);

    text-decoration: none;

    font-size: 14px;

    font-weight: 600;

    transition:
        color 0.2s ease,
        background-color 0.2s ease;

}


.site-header .nav a:hover,
.site-header .nav a:focus-visible {

    color: var(--primary);

    background-color: var(--primary-light);

}


/* =========================================================
   FIRMA VISUAL: LÍNEA DE RUTA
========================================================= */

.route-divider {

    position: relative;

    width: 90%;

    max-width: 1000px;

    height: 2px;

    margin: 8px auto;

    background-image:
        linear-gradient(
            to right,
            var(--border) 55%,
            transparent 0%
        );

    background-position: top;

    background-size: 14px 2px;

    background-repeat: repeat-x;

}


.route-divider::before,
.route-divider::after {

    content: "";

    position: absolute;

    top: 50%;

    width: 9px;

    height: 9px;

    border-radius: 50%;

    background: var(--primary);

    transform: translateY(-50%);

    box-shadow: 0 0 0 4px var(--primary-light);

}


.route-divider::before {

    left: -3px;

}


.route-divider::after {

    right: -3px;

}


/* =========================================================
   ACCESIBILIDAD: FOCO VISIBLE
========================================================= */

a:focus-visible,
button:focus-visible {

    outline: 2px solid var(--primary);

    outline-offset: 2px;
}


/* =========================================================
   RESET LOCAL
========================================================= */

.page-header,
.team-section,
.about-section,
.page-end {

    width: 100%;

}


/* =========================================================
   ENCABEZADO DE LA PÁGINA
========================================================= */

.page-header {

    background: var(--white);

    border-bottom: 1px solid var(--border);

    padding: 70px 20px 65px;

}


.page-header-content {

    width: 90%;

    max-width: 1000px;

    margin: auto;

}


.small-title {

    display: block;

    margin-bottom: 12px;

    color: var(--primary);

    font-size: 12px;

}


.page-header h2 {

    margin: 0 0 15px;

    color: var(--dark);

    font-size: clamp(38px, 5vw, 58px);

    font-weight: 700;

    line-height: 1.05;

}


.page-header p {

    max-width: 550px;

    margin: 0;

    color: var(--text-light);

    font-size: 17px;

    line-height: 1.6;

}


/* =========================================================
   EQUIPO
========================================================= */

.team-section {

    background: var(--background);

    padding: 70px 20px 90px;

}


.section-heading {

    width: 90%;

    max-width: 1000px;

    margin: 0 auto 45px;

}


.section-heading span {

    display: block;

    margin-bottom: 10px;

    color: var(--primary);

    font-size: 11px;

}


.section-heading h2 {

    margin: 0;

    color: var(--dark);

    font-size: 32px;

    font-weight: 700;

}


/* =========================================================
   CONTENEDOR DE PERSONAS
========================================================= */

.team-container {

    width: 90%;

    max-width: 1000px;

    margin: auto;

    display: flex;

    flex-direction: column;

    gap: 6px;

}


/* =========================================================
   TARJETA
========================================================= */

.team-card {

    display: grid;

    grid-template-columns: 280px 1fr;

    min-height: 320px;

    background: var(--white);

    border: 1px solid var(--border);

    border-radius: var(--radius);

    overflow: hidden;

    position: relative;

    box-shadow: var(--shadow);

    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        border-color 0.3s ease;

}


.team-card::before {

    content: "";

    position: absolute;

    top: 0;

    left: 0;

    width: 100%;

    height: 4px;

    background:
        linear-gradient(
            90deg,
            var(--primary),
            #60a5fa
        );

}


.team-card:hover {

    transform: translateY(-5px);

    box-shadow: var(--shadow-hover);

    border-color: #bfdbfe;

}


/* =========================================================
   FOTO
========================================================= */

.person-photo {

    min-height: 320px;

    display: flex;

    align-items: center;

    justify-content: center;

    background: var(--primary-light);

}


.person-photo img {

    display: block;

    width: 210px;

    height: 250px;

    object-fit: cover;

    border-radius: 10px;

    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.18);

}


/* =========================================================
   FOTO PROVISIONAL
========================================================= */

.person-photo-placeholder {

    background:
        linear-gradient(
            160deg,
            var(--primary-light),
            #e0ecff
        );

}


.person-photo-placeholder span {

    width: 210px;

    height: 250px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 10px;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--primary-dark)
        );

    color: white;

    font-family: var(--font-display);

    font-size: 45px;

    font-weight: 700;

    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.25);

}


/* =========================================================
   INFORMACIÓN
========================================================= */

.person-content {

    padding: 38px 42px;

    display: flex;

    flex-direction: column;

    align-items: flex-start;

}


.person-role {

    margin-bottom: 10px;

    color: var(--primary);

    font-size: 11px;

}


.person-content h3 {

    max-width: 550px;

    margin: 0 0 17px;

    color: var(--dark);

    font-size: 25px;

    font-weight: 700;

    line-height: 1.2;

}


.person-content p {

    max-width: 600px;

    margin: 0 0 10px;

    color: var(--text-light);

    font-size: 14px;

    line-height: 1.7;

}


/* =========================================================
   TECNOLOGÍAS
========================================================= */

.technology-list {

    display: flex;

    flex-wrap: wrap;

    gap: 7px;

    margin: 12px 0 22px;

}


.technology-list span {

    padding: 6px 11px;

    background: var(--primary-light);

    border: 1px solid #dbeafe;

    border-radius: 999px;

    color: var(--primary-dark);

    font-family: var(--font-mono);

    font-size: 11px;

    font-weight: 600;

}


/* =========================================================
   BOTÓN PERSONA
========================================================= */

.person-button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    padding: 11px 18px;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--primary-dark)
        );

    border-radius: 8px;

    color: white;

    text-decoration: none;

    font-size: 12px;

    font-weight: 700;

    box-shadow:
        0 6px 15px rgba(37, 99, 235, 0.20);

    transition:
        background 0.2s ease,
        transform 0.2s ease,
        box-shadow 0.2s ease;

}


.person-button:hover {

    transform: translateY(-2px);

    box-shadow:
        0 10px 20px rgba(37, 99, 235, 0.28);

}


.person-button span {

    font-size: 16px;

    line-height: 1;

}


.person-button.unavailable {

    background: #e2e8f0;

    color: var(--text-light);

    cursor: default;

    box-shadow: none;

}


.person-button.unavailable:hover {

    background: #e2e8f0;

    transform: none;

}


/* =========================================================
   SOBRE EL PROYECTO
========================================================= */

.about-section {

    padding: 90px 20px;

    background: white;

    border-top: 1px solid var(--border);

}


.about-content {

    width: 90%;

    max-width: 1000px;

    margin: auto;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 80px;

    align-items: start;

}


.about-title span {

    color: var(--primary);

    font-size: 11px;

}


.about-title h2 {

    margin: 12px 0 0;

    color: var(--dark);

    font-size: 31px;

    font-weight: 700;

    line-height: 1.25;

}


.about-text p {

    margin: 0 0 15px;

    color: var(--text-light);

    font-size: 15px;

    line-height: 1.8;

}


/* =========================================================
   CARACTERÍSTICAS
   Los números funcionan como paradas de una ruta: cada
   característica es una "parada" en el recorrido del proyecto.
========================================================= */

.project-features {

    width: 90%;

    max-width: 1000px;

    margin: 60px auto 0;

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    border-top: 1px solid var(--border);

    border-bottom: 1px solid var(--border);

}


.feature {

    padding: 28px 25px;

    border-right: 1px solid var(--border);

}


.feature:last-child {

    border-right: none;

}


.feature-number {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    width: 28px;

    height: 28px;

    margin-bottom: 14px;

    border-radius: 50%;

    background: var(--primary-light);

    color: var(--primary);

    font-family: var(--font-mono);

    font-size: 12px;

    font-weight: 700;

    box-shadow: 0 0 0 3px var(--white), 0 0 0 4px var(--border);

}


.feature h3 {

    margin: 0 0 8px;

    color: var(--dark);

    font-size: 17px;

    font-weight: 700;

}


.feature p {

    margin: 0;

    color: var(--text-light);

    font-size: 13px;

    line-height: 1.6;

}


/* =========================================================
   FINAL
========================================================= */

.page-end {

    padding: 75px 20px;

    background:
        linear-gradient(
            135deg,
            var(--dark),
            var(--dark-secondary)
        );

}


.page-end > div {

    width: 90%;

    max-width: 1000px;

    margin: auto;

}


.page-end > div:first-child {

    margin-bottom: 28px;

}


.page-end span {

    display: block;

    margin-bottom: 10px;

    color: #93c5fd;

    font-size: 11px;

}


.page-end h2 {

    margin: 0 0 10px;

    color: white;

    font-size: 31px;

    font-weight: 700;

}


.page-end p {

    max-width: 600px;

    margin: 0;

    color: #cbd5e1;

    font-size: 14px;

    line-height: 1.7;

}


/* =========================================================
   BOTONES FINALES
========================================================= */

.page-end-buttons {

    display: flex;

    gap: 10px;

}


.end-button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding: 12px 18px;

    border-radius: 8px;

    font-size: 12px;

    font-weight: 700;

    text-decoration: none;

    transition:
        background 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;

}


.main-button {

    background: white;

    color: var(--primary-dark);

}


.main-button:hover {

    background: #e9f1ea;

    transform: translateY(-2px);

}


.back-button {

    border: 1px solid rgba(255, 255, 255, 0.35);

    color: white;

}


.back-button:hover {

    background: rgba(255, 255, 255, 0.1);

    transform: translateY(-2px);

}


/* =========================================================
   FOOTER
========================================================= */

.footer {

    background: var(--dark);

}


.footer-content {

    width: 90%;

    max-width: 1000px;

    margin: auto;

    padding: 35px 0;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;

}


.footer-brand h3 {

    margin: 0 0 5px;

    color: white;

    font-size: 18px;

    font-weight: 700;

}


.footer-brand p {

    margin: 0;

    color: #94a3b8;

    font-size: 12px;

}


.footer-links {

    display: flex;

    gap: 22px;

}


.footer-links a {

    color: #cbd5e1;

    font-size: 12px;

    text-decoration: none;

}


.footer-links a:hover {

    color: #93c5fd;

}


.footer-bottom {

    padding: 15px 20px;

    border-top: 1px solid rgba(255, 255, 255, 0.08);

    color: #64748b;

    text-align: center;

    font-family: var(--font-mono);

    font-size: 10px;

}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 850px) {

    .team-card {

        grid-template-columns: 230px 1fr;

    }

    .person-photo {

        min-height: 300px;

    }

    .person-photo img,
    .person-photo-placeholder span {

        width: 175px;

        height: 220px;

    }

    .person-content {

        padding: 30px;

    }

    .about-content {

        grid-template-columns: 1fr;

        gap: 30px;

    }

}


/* =========================================================
   CELULAR
========================================================= */

@media (max-width: 650px) {

    .site-header {

        flex-direction: column;

        gap: 12px;

        padding: 14px 5%;

    }

    .site-header .nav {

        width: 100%;

        justify-content: center;

        flex-wrap: wrap;

        gap: 4px;

    }

    .site-header .nav a {

        padding: 8px 11px;

        font-size: 13px;

    }


    .page-header {

        padding: 55px 20px;

    }


    .page-header-content {

        width: 100%;

    }


    .page-header h2 {

        font-size: 39px;

    }


    .team-section {

        padding: 55px 20px 65px;

    }


    .section-heading {

        width: 100%;

        margin-bottom: 30px;

    }


    .team-container {

        width: 100%;

    }


    .team-card {

        display: block;

    }


    .person-photo {

        min-height: 270px;

        height: 270px;

    }


    .person-photo img,
    .person-photo-placeholder span {

        width: 190px;

        height: 225px;

    }


    .person-content {

        padding: 28px 24px 30px;

    }


    .person-content h3 {

        font-size: 22px;

    }


    .about-section {

        padding: 65px 20px;

    }


    .about-content {

        width: 100%;

    }


    .project-features {

        width: 100%;

        grid-template-columns: 1fr;

    }


    .feature {

        border-right: none;

        border-bottom: 1px solid var(--border);

    }


    .feature:last-child {

        border-bottom: none;

    }


    .page-end {

        padding: 60px 20px;

    }


    .page-end > div {

        width: 100%;

    }


    .page-end h2 {

        font-size: 27px;

    }


    .page-end-buttons {

        flex-direction: column;

    }


    .end-button {

        width: 100%;

    }


    .footer-content {

        flex-direction: column;

        text-align: center;

    }


    .footer-links {

        justify-content: center;

        flex-wrap: wrap;

    }

}


/* =========================================================
   CELULARES PEQUEÑOS
========================================================= */

@media (max-width: 400px) {

    .site-header .logo-text h1 {

        font-size: 17px;

    }

    .site-header .nav a {

        padding: 7px 8px;

        font-size: 12px;

    }


    .page-header h2 {

        font-size: 34px;

    }


    .person-photo {

        height: 240px;

        min-height: 240px;

    }


    .person-photo img,
    .person-photo-placeholder span {

        width: 165px;

        height: 200px;

    }


    .person-content {

        padding: 24px 20px;

    }


    .person-content h3 {

        font-size: 20px;

    }

}