/* =========================================================
   BUSUCR - INFO
   DISEÑO MINIMALISTA
========================================================= */


/* =========================================================
   VARIABLES
========================================================= */

:root {

    --green: #2e7d32;
    --green-dark: #1f5c26;
    --green-light: #eaf4eb;

    --white: #ffffff;

    --background: #f7f8f7;
    --text: #202522;
    --text-light: #68716b;

    --border: #e1e6e2;

}


/* =========================================================
   RESET LOCAL
========================================================= */

.info-intro,
.page-header,
.team-section,
.about-section,
.page-end {

    width: 100%;

}


/* =========================================================
   HEADER DE LA PÁGINA
========================================================= */

.page-header {

    background: #ffffff;

    border-bottom: 1px solid var(--border);

    padding: 70px 20px 65px;

}


.page-header-content {

    width: 90%;

    max-width: 1000px;

    margin: auto;

}


.small-title {

    display: block;

    margin-bottom: 12px;

    color: var(--green);

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 2px;

}


.page-header h2 {

    margin: 0 0 15px;

    color: var(--text);

    font-size: clamp(38px, 5vw, 58px);

    font-weight: 700;

    line-height: 1.05;

}


.page-header p {

    max-width: 550px;

    margin: 0;

    color: var(--text-light);

    font-size: 17px;

    line-height: 1.6;

}


/* =========================================================
   EQUIPO
========================================================= */

.team-section {

    background: var(--background);

    padding: 85px 20px 100px;

}


.section-heading {

    width: 90%;

    max-width: 1000px;

    margin: 0 auto 45px;

}


.section-heading span {

    display: block;

    margin-bottom: 10px;

    color: var(--green);

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 2px;

}


.section-heading h2 {

    margin: 0;

    color: var(--text);

    font-size: 32px;

    font-weight: 650;

}


/* =========================================================
   CONTENEDOR DE PERSONAS
========================================================= */

.team-container {

    width: 90%;

    max-width: 1000px;

    margin: auto;

    display: flex;

    flex-direction: column;

    gap: 25px;

}


/* =========================================================
   TARJETA
========================================================= */

.team-card {

    display: grid;

    grid-template-columns: 280px 1fr;

    min-height: 320px;

    background: var(--white);

    border: 1px solid var(--border);

    border-radius: 10px;

    overflow: hidden;

}


/* =========================================================
   FOTO
========================================================= */

.person-photo {

    min-height: 320px;

    display: flex;

    align-items: center;

    justify-content: center;

    background: var(--green-light);

}


.person-photo img {

    display: block;

    width: 210px;

    height: 250px;

    object-fit: cover;

    border-radius: 8px;

}


/* =========================================================
   FOTO PROVISIONAL
========================================================= */

.person-photo-placeholder {

    background: #edf3ee;

}


.person-photo-placeholder span {

    width: 210px;

    height: 250px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 8px;

    background: var(--green);

    color: white;

    font-size: 45px;

    font-weight: 700;

}


/* =========================================================
   INFORMACIÓN
========================================================= */

.person-content {

    padding: 38px 42px;

    display: flex;

    flex-direction: column;

    align-items: flex-start;

}


.person-role {

    margin-bottom: 10px;

    color: var(--green);

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 1.5px;

}


.person-content h3 {

    max-width: 550px;

    margin: 0 0 17px;

    color: var(--text);

    font-size: 25px;

    line-height: 1.2;

}


.person-content p {

    max-width: 600px;

    margin: 0 0 10px;

    color: var(--text-light);

    font-size: 14px;

    line-height: 1.7;

}


/* =========================================================
   TECNOLOGÍAS
========================================================= */

.technology-list {

    display: flex;

    flex-wrap: wrap;

    gap: 7px;

    margin: 12px 0 22px;

}


.technology-list span {

    padding: 6px 10px;

    background: #f4f6f4;

    border: 1px solid var(--border);

    border-radius: 4px;

    color: #56605a;

    font-size: 11px;

    font-weight: 600;

}


/* =========================================================
   BOTÓN PERSONA
========================================================= */

.person-button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    padding: 10px 16px;

    background: var(--green);

    border-radius: 5px;

    color: white;

    text-decoration: none;

    font-size: 12px;

    font-weight: 700;

    transition:
        background 0.2s ease,
        transform 0.2s ease;

}


.person-button:hover {

    background: var(--green-dark);

    transform: translateY(-2px);

}


.person-button span {

    font-size: 16px;

    line-height: 1;

}


.person-button.unavailable {

    background: #dce1dd;

    color: #727a74;

    cursor: default;

}


.person-button.unavailable:hover {

    background: #dce1dd;

    transform: none;

}


/* =========================================================
   SOBRE EL PROYECTO
========================================================= */

.about-section {

    padding: 90px 20px;

    background: white;

    border-top: 1px solid var(--border);

}


.about-content {

    width: 90%;

    max-width: 1000px;

    margin: auto;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 80px;

    align-items: start;

}


.about-title span {

    color: var(--green);

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 2px;

}


.about-title h2 {

    margin: 12px 0 0;

    color: var(--text);

    font-size: 31px;

    line-height: 1.25;

}


.about-text p {

    margin: 0 0 15px;

    color: var(--text-light);

    font-size: 15px;

    line-height: 1.8;

}


/* =========================================================
   CARACTERÍSTICAS
========================================================= */

.project-features {

    width: 90%;

    max-width: 1000px;

    margin: 60px auto 0;

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    border-top: 1px solid var(--border);

    border-bottom: 1px solid var(--border);

}


.feature {

    padding: 28px 25px;

    border-right: 1px solid var(--border);

}


.feature:last-child {

    border-right: none;

}


.feature-number {

    display: block;

    margin-bottom: 15px;

    color: var(--green);

    font-size: 11px;

    font-weight: 700;

}


.feature h3 {

    margin: 0 0 8px;

    color: var(--text);

    font-size: 17px;

}


.feature p {

    margin: 0;

    color: var(--text-light);

    font-size: 13px;

    line-height: 1.6;

}


/* =========================================================
   FINAL
========================================================= */

.page-end {

    padding: 75px 20px;

    background: var(--green-dark);

}


.page-end > div {

    width: 90%;

    max-width: 1000px;

    margin: auto;

}


.page-end > div:first-child {

    margin-bottom: 28px;

}


.page-end span {

    display: block;

    margin-bottom: 10px;

    color: #a9d3ad;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 2px;

}


.page-end h2 {

    margin: 0 0 10px;

    color: white;

    font-size: 31px;

}


.page-end p {

    max-width: 600px;

    margin: 0;

    color: #d0dfd2;

    font-size: 14px;

    line-height: 1.7;

}


/* =========================================================
   BOTONES FINALES
========================================================= */

.page-end-buttons {

    display: flex;

    gap: 10px;

}


.end-button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding: 11px 17px;

    border-radius: 5px;

    font-size: 12px;

    font-weight: 700;

    text-decoration: none;

    transition:
        background 0.2s ease,
        color 0.2s ease;

}


.main-button {

    background: white;

    color: var(--green-dark);

}


.main-button:hover {

    background: #e9f1ea;

}


.back-button {

    border: 1px solid rgba(255,255,255,0.5);

    color: white;

}


.back-button:hover {

    background: rgba(255,255,255,0.1);

}


/* =========================================================
   FOOTER
========================================================= */

.footer {

    background: #101a13;

}


.footer-content {

    width: 90%;

    max-width: 1000px;

    margin: auto;

    padding: 35px 0;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;

}


.footer-brand h3 {

    margin: 0 0 5px;

    color: white;

    font-size: 18px;

}


.footer-brand p {

    margin: 0;

    color: #9daaa0;

    font-size: 12px;

}


.footer-links {

    display: flex;

    gap: 22px;

}


.footer-links a {

    color: #c5cec7;

    font-size: 12px;

    text-decoration: none;

}


.footer-links a:hover {

    color: #a9d3ad;

}


.footer-bottom {

    padding: 15px 20px;

    border-top: 1px solid rgba(255,255,255,0.08);

    color: #89958c;

    text-align: center;

    font-size: 10px;

}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 850px) {

    .team-card {

        grid-template-columns: 230px 1fr;

    }

    .person-photo {

        min-height: 300px;

    }

    .person-photo img,
    .person-photo-placeholder span {

        width: 175px;

        height: 220px;

    }

    .person-content {

        padding: 30px;

    }

    .about-content {

        grid-template-columns: 1fr;

        gap: 30px;

    }

}


/* =========================================================
   CELULAR
========================================================= */

@media (max-width: 650px) {

    .page-header {

        padding: 55px 20px;

    }


    .page-header-content {

        width: 100%;

    }


    .page-header h2 {

        font-size: 39px;

    }


    .team-section {

        padding: 60px 20px 70px;

    }


    .section-heading {

        width: 100%;

        margin-bottom: 30px;

    }


    .team-container {

        width: 100%;

    }


    .team-card {

        display: block;

    }


    .person-photo {

        min-height: 270px;

        height: 270px;

    }


    .person-photo img,
    .person-photo-placeholder span {

        width: 190px;

        height: 225px;

    }


    .person-content {

        padding: 28px 24px 30px;

    }


    .person-content h3 {

        font-size: 22px;

    }


    .about-section {

        padding: 65px 20px;

    }


    .about-content {

        width: 100%;

    }


    .project-features {

        width: 100%;

        grid-template-columns: 1fr;

    }


    .feature {

        border-right: none;

        border-bottom: 1px solid var(--border);

    }


    .feature:last-child {

        border-bottom: none;

    }


    .page-end {

        padding: 60px 20px;

    }


    .page-end > div {

        width: 100%;

    }


    .page-end h2 {

        font-size: 27px;

    }


    .page-end-buttons {

        flex-direction: column;

    }


    .end-button {

        width: 100%;

    }


    .footer-content {

        flex-direction: column;

        text-align: center;

    }


    .footer-links {

        justify-content: center;

        flex-wrap: wrap;

    }

}


/* =========================================================
   CELULARES PEQUEÑOS
========================================================= */

@media (max-width: 400px) {

    .page-header h2 {

        font-size: 34px;

    }


    .person-photo {

        height: 240px;

        min-height: 240px;

    }


    .person-photo img,
    .person-photo-placeholder span {

        width: 165px;

        height: 200px;

    }


    .person-content {

        padding: 24px 20px;

    }


    .person-content h3 {

        font-size: 20px;

    }

}